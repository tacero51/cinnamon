{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cinnamon",
  "compatibility_date": "2026-05-15",
  "preview_urls": false,
  "main": "src/worker.js",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "cinnamon-photos"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "secrets": {
    "required": [
      "LOGIN_USERNAME",
      "LOGIN_PASSWORD",
      "SESSION_SIGNING_KEY"
    ]
  }
}
